# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
all md files/
documentation/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit
.env

# Build-time app config (backend URL) — keep out of git, see env/production.example.json
env/*.json
!env/*.example.json

# Secrets — never commit (rotate anything that was committed previously)
*firebase-adminsdk*.json
android/key.properties
*.jks
*.keystore
supabase/.temp/

# Edge Function secret values (pushed with `supabase secrets set --env-file`)
supabase/.env.secrets
