# Email configuration (Gmail SMTP — set App Password, not account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Groq AI (Llama 3.3 70B) — get key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Admin setup key — required to create the first admin account via POST /api/admin/auth/signup
# Change this to a strong secret before deploying
ADMIN_SETUP_KEY=safarsync_admin_setup_2024

# Firebase Admin SDK (optional — leave empty to run in DEV mode without signature verification)
# Set to raw JSON string or base64-encoded service account key JSON
FIREBASE_SERVICE_ACCOUNT_KEY=

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
