DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=safarsync
DB_PORT=3306
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Email configuration (Gmail SMTP — set App Password, not account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Groq AI (Llama 3.3 70B) — get key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK (optional — leave empty to run in DEV mode without signature verification)
# Set to raw JSON string or base64-encoded service account key JSON
FIREBASE_SERVICE_ACCOUNT_KEY=
