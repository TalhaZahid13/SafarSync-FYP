# Copy to .env for local development. On a host (Render, Railway, …) set these
# as environment variables instead — never commit real values.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Public HTTPS URL of the deployed API (used to build upload URLs)
BACKEND_URL=

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=safarsync
# true for hosted MySQL that requires TLS
DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin service account (JSON string or base64 of it).
# REQUIRED when NODE_ENV=production — without it, sign-in is refused.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Behind a reverse proxy (automatically on when NODE_ENV=production)
TRUST_PROXY=

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

ADMIN_SETUP_KEY=
OWM_API_KEY=
